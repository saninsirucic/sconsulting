NODE_ENV=development
DATABASE_URL=
APP_BASE_URL=http://localhost:3002

# Authentication for protected AI mail routes.
# JSON array with: id, username, passwordHash (bcrypt), role and active.
AUTH_USERS_JSON=
JWT_SECRET=
JWT_EXPIRES_IN=8h

MAIL_PROVIDER=microsoft_graph
MAIL_SENDER_ADDRESS=sales@s-consulting.ba
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=
MAIL_TEST_MODE=true

# Upload and campaign safety defaults.
AI_EMAIL_MAX_UPLOAD_MB=10
AI_EMAIL_DAILY_LIMIT=20
AI_EMAIL_MIN_INTERVAL_MINUTES=5
AI_EMAIL_TIMEZONE=Europe/Sarajevo
