NODE_ENV=development
DATABASE_URL=
APP_BASE_URL=http://localhost:3002

# Authentication for protected AI mail routes.
# JSON array with: id, username, passwordHash (bcrypt), role and active.
AUTH_USERS_JSON=
JWT_SECRET=
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_RATE_LIMIT_MAX_KEYS=10000

MAIL_PROVIDER=microsoft_graph
MAIL_SENDER_ADDRESS=sales@s-consulting.ba
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Shared Outlook mailbox is hard-bound in code to sales@s-consulting.ba.
OUTLOOK_MAILBOX_ADDRESS=sales@s-consulting.ba
OUTLOOK_ALLOWED_MAILBOXES=sales@s-consulting.ba
# Server-side kill switch. Reads remain available when false.
OUTLOOK_MAIL_WRITES_ENABLED=false
# Optional; JWT_SECRET is used for cursor signing when omitted.
OUTLOOK_CURSOR_SECRET=
OUTLOOK_MAX_ATTACHMENTS=5
OUTLOOK_MAX_ATTACHMENT_BYTES=2500000
OUTLOOK_MAX_TOTAL_ATTACHMENT_BYTES=5000000
OUTLOOK_GRAPH_TIMEOUT_MS=7000
OUTLOOK_GRAPH_READ_RETRIES=2
OUTLOOK_GRAPH_MAX_RETRY_DELAY_MS=2000
OUTLOOK_MAX_JSON_RESPONSE_BYTES=5000000
# Backend only. Never use REACT_APP_ variables for these values.
OPENAI_API_KEY=
# Required and intentionally has no implicit default; choose an approved model.
OPENAI_MODEL=
MAIL_TEST_MODE=true

# Upload and campaign safety defaults.
AI_EMAIL_MAX_UPLOAD_MB=10
AI_EMAIL_DAILY_LIMIT=20
AI_EMAIL_MIN_INTERVAL_MINUTES=5
AI_EMAIL_TIMEZONE=Europe/Sarajevo
